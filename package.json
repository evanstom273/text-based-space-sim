{
  "name": "text-based-space-sim",
  "private": true,
  "version": "0.1.0",
  "description": "Planetary Union command terminal starship operations",
  "author": "Planetary Union",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "dist:win": "npm run build && electron-builder --win",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "electron:start": "electron .",
    "verify:personnel": "tsx -e \"import { verifyPersonnelFoundation } from './src/domain/personnel/verifyFoundation.ts'; const r = verifyPersonnelFoundation(); console.log(JSON.stringify(r, null, 2)); if (!r.ok) process.exit(1);\""
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.1.18",
    "lucide-react": "^0.563.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwindcss": "^4.1.18"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "electron": "^43.4.1",
    "electron-builder": "^26.15.3",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "build": {
    "appId": "com.planetaryunion.terminal",
    "productName": "Union Terminal",
    "copyright": "Copyright © 2026 Planetary Union",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*"
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Union Terminal"
    }
  }
}
